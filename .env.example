# Copy to .env and fill in. Never commit .env.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional overrides
GEMINI_MODEL=gemini-3.5-flash-lite
LLM_FALLBACK_MODEL=gemini-3.8-flash
LLM_THINKING_LEVEL=low
LOG_LEVEL=INFO
# USE_FIXTURES (saved test responses for local development) is NOT read from this file.
# Set it in the shell when starting the dev server: $env:USE_FIXTURES = "1"; .\run.ps1
# It has no effect on Render: the deployed start command never loads fixture mode.
# Optional: where saved data lives (defaults: backend/data for the rainfall baseline,
# backend/.cache for the SoilGrids cache). Both are rebuilt automatically from the live APIs.
# YIELDGUARD_DATA_DIR=
# YIELDGUARD_CACHE_DIR=
